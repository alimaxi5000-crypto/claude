{
  "name": "jays-project-launcher",
  "productName": "Jays Project",
  "version": "0.1.0-alpha",
  "description": "Jays Project launcher (V0.1 Alpha prototype)",
  "main": "src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist:win": "npx --yes electron-builder@25.1.8 --win portable"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "playwright-core": "1.49.1"
  },
  "build": {
    "appId": "dev.jaysproject.launcher",
    "productName": "Jays Project",
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "extraResources": [
      { "from": "../build/bin", "to": "bin", "filter": ["jays-client*", "jays-server*"] },
      { "from": "../server/data", "to": "server-data" }
    ],
    "win": { "target": "portable", "icon": "assets/icon.png" }
  }
}
